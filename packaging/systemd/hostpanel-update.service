[Unit]
Description=Check and apply signed HostPanel GitHub release updates
Documentation=https://github.com/1-vps/hostpanel
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/hostpanel/tools/hostpanel-update
ConditionPathExists=/etc/hostpanel/update.pub

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/hostpanel/update-agent.conf
ExecStartPre=/bin/sh -ec 'p=/etc/hostpanel/github-update.token; [ ! -e "$p" ] || { [ -f "$p" ] && [ ! -L "$p" ] && [ "$(stat -c "%%u:%%a:%%h" "$p")" = "0:600:1" ]; }'
ExecStart=/opt/hostpanel/tools/hostpanel-update --apply --auto
UMask=0077
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TimeoutStartSec=3h
