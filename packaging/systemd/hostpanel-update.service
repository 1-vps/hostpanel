[Unit]
Description=Check and apply signed HostPanel GitHub release updates
Documentation=https://github.com/1-vps/hostpanel
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/hostpanel/tools/hostpanel-update
ConditionPathExists=/etc/hostpanel/update.pub
ConditionPathExists=/etc/hostpanel/update-keyring.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/hostpanel/tools/hostpanel-update --apply --auto
SuccessExitStatus=10 75
UMask=0077
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TimeoutStartSec=3h
